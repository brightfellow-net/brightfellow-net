---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn’t exist." noindex>
  <div class="wrap page">
    <header class="page-head">
      <h1>Page not found</h1>
      <p class="lede">The link may be wrong, or the page has moved.</p>
      <p class="lede" lang="id">Halaman ini tidak ada. Mungkin tautannya salah atau halamannya sudah dipindahkan.</p>
      <div class="actions">
        <a class="btn" href="/">Go to the home page</a>
        <a class="arrow" href="/id/" lang="id">Ke beranda bahasa Indonesia</a>
      </div>
    </header>
  </div>
</Base>
