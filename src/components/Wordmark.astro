---
import Mark from './Mark.astro';

interface Props { href?: string; label?: string; class?: string }
const { href, label = 'Brightfellow', class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag class:list={["wm", className]} href={href} aria-label={label} role={href ? undefined : "img"}><span aria-hidden="true">br<span class="i">ı<Mark /></span>ghtfellow</span></Tag>

<style>
  .wm {
    font-family: var(--serif);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .i { position: relative; display: inline-block; }
  .i :global(.mark) {
    position: absolute;
    width: 0.4em;
    height: 0.25em;
    left: 50%;
    top: 0.06em;
    transform: translateX(-50%);
  }
</style>
