---
import '@fontsource/literata/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLang, langMeta, localize, stripLang, ui, langs } from '../i18n/ui';
import { site } from '../site';

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const lang = getLang(Astro.url);
const path = stripLang(Astro.url.pathname);
const fullTitle = title ? `${title} · Brightfellow` : `Brightfellow · ${ui[lang].footerTagline}`;
const canonical = new URL(localize(lang, path), site.url).href;
const ogImage = new URL('/og.png', site.url).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a theme the visitor picked earlier (stored only in this browser) before first paint.
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && langs.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localize(l, path), site.url).href} />
    ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(path, site.url).href} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Brightfellow" />
    <meta property="og:title" content={title ?? 'Brightfellow'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Brightfellow" />
    <meta property="og:locale" content={langMeta[lang].ogLocale} />
    <meta property="og:locale:alternate" content={langMeta[lang === 'id' ? 'en' : 'id'].ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#FBF7F0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A1714" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip" href="#main">{ui[lang].skip}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
